# Required - your Discord account token (not a bot token)
DISCORD_TOKEN=your_token_here

# Comma-separated Discord user IDs with admin access (besides the bot account itself)
ALLOWED_USER_IDS=123456789012345678,987654321098765432

# Jellyfin - set JELLYFIN_URL plus an API key and/or a user login.
JELLYFIN_URL=http://192.168.1.100:8096
JELLYFIN_API_KEY=your_api_key_here
# Optional: sign in as a Jellyfin user. Required for SyncPlay (group watch):
# the bot opens a SyncPlay group so Jellyfin app users can pause/play/seek the
# Discord stream. Use a dedicated user with SyncPlay access to your libraries.
JELLYFIN_USERNAME=
JELLYFIN_PASSWORD=
# Play the original file and transcode once in the bot (default true). false
# always uses Jellyfin's transcode.
JELLYFIN_DIRECT_STREAM=true

# Output stream quality preset: 720p, 1080p (default) or 4k. Discord enforces
# per-account resolution/fps caps, so pick one your account supports.
STREAM_QUALITY=1080p

# Per-axis overrides of the preset (leave empty to use the preset).
#   STREAM_RESOLUTION: W:H (or WxH)
#   STREAM_FPS: frame-rate ceiling, 1-60; each stream follows the source rate
#               at or below it (a 23.976 fps film stays 23.976)
#   STREAM_VIDEO_BITRATE: constant bitrate, e.g. 7000k
STREAM_RESOLUTION=
STREAM_FPS=
STREAM_VIDEO_BITRATE=

# Read-ahead of video and audio in seconds (0-30, default 8).
STREAM_BUFFER_SECONDS=8

# Pace each frame's RTP packets across this fraction of the frame interval
# instead of bursting them (0.0 = off; e.g. 0.75). Clamped to 0.0-0.95.
STREAM_PACKET_PACE=0.0

# Lip-sync offset in ms (default 0). Positive plays audio earlier. Clamped to +/-5000.
STREAM_AV_SYNC_MS=0

# Optional images shown on the stream while it loads / while paused: a file path
# (mount it into the container) or an http(s) URL, downloaded once at startup.
STREAM_LOADING_IMAGE=
STREAM_PAUSED_IMAGE=

# Stop and leave after the voice channel stayed empty this many minutes (0-1440, default 20).
EMPTY_CHANNEL_TIMEOUT_MINUTES=20
